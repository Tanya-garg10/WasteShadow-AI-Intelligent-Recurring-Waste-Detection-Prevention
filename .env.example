# ==============================================================================
# WasteShadow AI — Environment Configuration Template
# (Do NOT commit real keys to version control)
# ==============================================================================

# Featherless AI API Key (replaces Gemini)
# Get your key at: https://featherless.ai/
FEATHERLESS_API_KEY="YOUR_FEATHERLESS_API_KEY"

# (Optional) Override the vision model — must support vision on Featherless
# Browse vision models at: https://featherless.ai/models?modalities=vision
FEATHERLESS_MODEL="google/gemma-3-27b-it"

# Vite (Frontend) Featherless keys
VITE_FEATHERLESS_API_KEY="YOUR_FEATHERLESS_API_KEY"
VITE_FEATHERLESS_MODEL="google/gemma-3-27b-it"

# Python FastAPI Backend Configuration
PORT=8000

# DATABASE — Choose one:

# Option 1: Local SQLite (default, no setup needed)
DATABASE_URL="sqlite:///./wasteshadow.db"

# Option 2: Neon PostgreSQL (production-ready, free tier)
# Get your connection string from: https://console.neon.tech
# Project Settings → Connection Details → Connection string
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-XXXXX.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Client Vite API Base URL (defaults to client-side embedded proxy if empty)
VITE_API_BASE_URL=""
VITE_GEMINI_API_KEY=""
