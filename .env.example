# ==============================================================================
# WasteShadow AI — Environment Configuration Template
# (Do NOT commit real keys to version control)
# ==============================================================================

# Gemini Multimodal Vision API Key
# In Google AI Studio, injected automatically via user secrets.
# For local / standalone development: get one at https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# AI Studio App Hosting URL
APP_URL="MY_APP_URL"

# Python FastAPI Backend Configuration (Optional standalone)
PORT=8000
DATABASE_URL="sqlite:///./wasteshadow.db"
# Or for PostgreSQL / Supabase:
# DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"

# Supabase Auth & Storage (Optional for standalone cloud persistence)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# Client Vite API Base URL (defaults to client-side embedded proxy if empty)
VITE_API_BASE_URL=""
VITE_GEMINI_API_KEY=""
